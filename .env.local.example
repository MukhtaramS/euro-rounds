# n8n production webhook base (no trailing slash)
N8N_WEBHOOK_BASE=https://<your-instance>.app.n8n.cloud/webhook
# Same value as the "Euro Rounds App Key" Header Auth credential in n8n (header name: x-euro-rounds-key)
EURO_ROUNDS_KEY=
# Optional: protects the whole app with a password (username can be anything)
APP_PASSWORD=
